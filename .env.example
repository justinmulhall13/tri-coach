# ─── Garmin (direct garminconnect) ──────────────────────────────────────────
# Used for the one-time login that caches an OAuth token in ~/.garminconnect/.
# After login you may blank the password; the cached token auto-refreshes.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password

# ─── Coach agent (Anthropic) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Latest/most capable default; override if you want.
COACH_MODEL=claude-opus-4-8
COACH_EFFORT=medium

# ─── Google Calendar (direct API) ───────────────────────────────────────────
# Path to the OAuth client file you download from Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Desktop app).
# First backend run opens a browser once and caches GOOGLE_TOKEN_FILE.
GOOGLE_CREDENTIALS_FILE=./data/credentials.json
GOOGLE_TOKEN_FILE=./data/token.json
# Comma-separated calendar IDs to read; "primary" = your main calendar.
GOOGLE_CALENDAR_IDS=primary

# ─── Race + athlete profile (EDIT THESE — not treated as ground truth) ──────
RACE_NAME=T100 Vancouver
RACE_DATE=2026-08-16
SWIM_KM=2.0
BIKE_KM=80
RUN_KM=18

# Athlete profile — verify/edit. The coach is told these are user-supplied.
ATHLETE_FTP_W=288
ATHLETE_SWIM_BACKGROUND=competitive swim background
ATHLETE_DEVICE=Garmin Fenix 8 + cycling power meter
ATHLETE_NOTES=Runs regularly. Confirm and edit before relying on these.

# ─── App ─────────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8770
DB_PATH=./data/coach.db
TIMEZONE=America/Vancouver
